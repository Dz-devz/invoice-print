generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model Invoice {
  id         Int           @id @default(autoincrement())
  invoice_no String        @unique
  createdAt  DateTime      @default(now())
  name       String
  items      InvoiceItem[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  description String
  quantity    Int
  price       Float
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}
